{
  "name": "blender-mcp-slots",
  "version": "1.2.0",
  "description": "Blender MCP 老虎机游戏模块：多主题机台共用同一套 CONFIG 引擎的 SLOT GAMES 合集",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/main.js",
    "start:http": "node src/main.js --transport=http",
    "start:stdio": "node src/main.js --transport=stdio",
    "simulate": "node scripts/simulate.js",
    "migrate": "node scripts/migrate.mjs",
    "site:serve": "node scripts/serve-site.mjs 8080",
    "site:check": "node scripts/check-site.mjs",
    "site:build": "node scripts/minify-site.mjs --slim",
    "site:og": "node scripts/og-cards.mjs",
    "site:smoke": "node scripts/smoke-live.mjs",
    "test": "node --test"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pg": "^8.23.1"
  },
  "keywords": [
    "mcp",
    "blender",
    "slot",
    "casino",
    "game-engine"
  ],
  "license": "MIT"
}
